{
  "manifest_version": 3,
  "name": "ClassMeet Attendance",
  "version": "1.0.0",
  "description": "Class codes, Google Meet sessions and automatic attendance tracking for teachers and students.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://meet.google.com/*",
    "https://YOUR-PROJECT-REF.supabase.co/*"
  ],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_popup": "popup.html", "default_title": "ClassMeet" },
  "content_scripts": [
    {
      "matches": ["https://meet.google.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
